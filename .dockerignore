# flyctl launch added from .gitignore
# Rust
**/target

# vendor/fivetran-connector is include_str!'d by src/fivetran.rs. It must
# stay in the gateway build context. Do not add a rule that excludes it.
!vendor/fivetran-connector/
!vendor/fivetran-connector/**

# Environment
**/.env
**/.env.local

# Node / Next.js
**/dashboard/node_modules
**/dashboard/.next
**/dashboard/out
**/dashboard/.env.local
**/dashboard/.env

# OS
**/.DS_Store
**/*.swp
**/*.swo

# Editor
**/.vscode
**/.idea
fly.toml
