# Local self-host placeholders. Copy to .env before:
#   docker compose -f docker-compose.yml -f docker-compose.selfhost.yml up --build
#
# These values are public placeholders for a private machine. They are not
# production secrets. Before any other host can reach the stack, replace
# SUPABASE_JWT_SECRET (at least 32 characters) and regenerate both keys
# with that secret, role "anon" and role "service_role", HS256, exp in the
# future. The authenticator database password is the local placeholder in
# ops/postgres/selfhost-roles.sql.

SUPABASE_JWT_SECRET=selfhost-placeholder-jwt-secret-change-me

# role=anon, iss=supabase-demo, iat=1700000000, exp=2000000000
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE3MDAwMDAwMDAsImV4cCI6MjAwMDAwMDAwMH0.FQCUyi7iBQeSGaeFYGpBRscSATPfYZlZUEi6YhcvRgo

# role=service_role, same window. Server-side only. Do not put this in a browser bundle.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZGVtbyIsImlhdCI6MTcwMDAwMDAwMCwiZXhwIjoyMDAwMDAwMDAwfQ.fVtRW0gwj7WJkhMjWIaC40ZZOS9PaN4DMe_DNtFvIJM
