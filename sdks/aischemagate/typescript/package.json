{
  "name": "@nightmoose/aischemagate",
  "version": "0.4.0",
  "description": "AISchemaGate — thin alias over @nightmoose/contractgate-sdk for LLM structured-output validation. Same engine as DataContractGate.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightmoose/contractgate.git",
    "directory": "sdks/aischemagate/typescript"
  },
  "homepage": "https://aischemagate.com",
  "keywords": [
    "llm",
    "openai",
    "anthropic",
    "json-schema",
    "validation",
    "ai",
    "agent",
    "guardrails",
    "contractgate",
    "aischemagate",
    "vercel-ai-sdk",
    "structured-output"
  ],
  "dependencies": {
    "@nightmoose/contractgate-sdk": "^0.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
