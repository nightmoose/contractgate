  "contract_yaml": "version: \"1.0\"\nname: parity_rfc118\nontology:\n  entities:\n    - name: status\n      type: string\n      enum: [booked, refunded]\n    - name: refund_reason\n      type: string\n      required: false\n    - name: start_date\n      type: date\n    - name: end_date\n      type: date\n    - name: created_at\n      type: timestamp\n    - name: updated_at\n      type: timestamp\n    - name: min_guests\n      type: integer\n    - name: max_guests\n      type: integer\n    - name: guest_email\n      type: string\n    - name: host_email\n      type: string\n    - name: max_line_qty\n      type: integer\n    - name: seen_unix\n      type: number\n      required: false\n    - name: seen_at\n      type: timestamp\n      required: false\n    - name: note\n      type: string\n      required: false\n      max_length: 4\n    - name: lines\n      type: array\n      items:\n        name: line\n        type: object\n        properties:\n          - name: code\n            type: string\n            pattern: \"^L-[0-9]{3}$\"\n          - name: qty\n            type: integer\n          - name: kind\n            type: string\n          - name: fee_reason\n            type: string\n            required: false\n    - name: tags\n      type: array\n      required: false\n      items:\n        name: tag\n        type: string\n        pattern: \"^[a-z]+$\"\nquality:\n  - field: guest_email\n    type: completeness\n  - field: seen_unix\n    type: freshness\n    max_age_seconds: 600\n  - field: seen_at\n    type: freshness\n    max_age_seconds: 600\ncross_field:\n  - field: end_date\n    op: gte\n    other: start_date\n  - field: updated_at\n    op: gt\n    other: created_at\n  - field: max_guests\n    op: gte\n    other: min_guests\n  - field: host_email\n    op: ne\n    other: guest_email\n  - field: refund_reason\n    required_if:\n      field: status\n      equals: refunded\n  - field: lines[].qty\n    op: lte\n    other: max_line_qty\n  - field: lines[].fee_reason\n