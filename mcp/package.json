{
  "name": "@nightmoose/contractgate-mcp-server",
  "version": "0.4.1",
  "mcpName": "io.github.nightmoose/contractgate",
  "description": "AISchemaGate validates and repairs structured LLM output against a contract, plus DataContractGate data contracts. LLM guardrails for structured output, alongside JSON Schema and Pydantic validation.",
  "homepage": "https://github.com/nightmoose/contractgate/tree/staging/mcp#readme",
  "license": "MIT",
  "type": "module",
  "bin": {
    "contractgate-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "prepublishOnly": "npm run build",
    "start": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightmoose/contractgate.git",
    "directory": "mcp"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "aischemagate",
    "llm",
    "structured output",
    "json schema",
    "pydantic validation",
    "llm guardrails",
    "structured-output",
    "json-schema",
    "pydantic",
    "llm-guardrails",
    "datacontractgate",
    "data-contracts",
    "odcs",
    "quarantine",
    "validation",
    "guardrails",
    "egress_validate"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
