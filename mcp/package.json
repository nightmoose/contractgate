{
  "name": "@nightmoose/contractgate-mcp-server",
  "version": "0.4.1",
  "mcpName": "io.github.nightmoose/contractgate",
  "description": "AISchemaGate validates and repairs structured LLM output against a contract, plus DataContractGate data contracts. Repair uses the violation fields from that check (min, max, pattern, enum, compliance_mode). The contract checks values a JSON Schema or Pydantic validation can leave open. DataContractGate infers and deploys contracts, validates ingest, including ODCS v3.1.0 and v3.2.0, and lists quarantine.",
  "homepage": "https://github.com/nightmoose/contractgate/tree/staging/mcp#readme",
  "license": "MIT",
  "type": "module",
  "bin": {
    "contractgate-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "prepublishOnly": "npm run build",
    "start": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightmoose/contractgate.git",
    "directory": "mcp"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "aischemagate",
    "llm",
    "structured output",
    "structured-output",
    "json schema",
    "json-schema",
    "pydantic validation",
    "pydantic",
    "llm guardrails",
    "llm-guardrails",
    "datacontractgate",
    "data-contracts",
    "odcs",
    "quarantine",
    "validation",
    "guardrails",
    "egress_validate"
  ],
  "dependencies": {
    "@tmcp/adapter-zod": "^0.1.9",
    "@tmcp/transport-stdio": "^0.5.1",
    "tmcp": "^1.20.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
