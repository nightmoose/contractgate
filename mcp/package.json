{
  "name": "@nightmoose/contractgate-mcp-server",
  "version": "0.4.0",
  "mcpName": "io.github.nightmoose/contractgate",
  "description": "Official MCP server for DataContractGate and AISchemaGate. DataContractGate: ingest-time data contract validation (ODCS v3.1/v3.2), PII masking, quarantine and replay. AISchemaGate: runtime LLM structured output validation via egress_validate, with violation-fed auto-repair.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "contractgate-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "prepublishOnly": "npm run build",
    "start": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightmoose/contractgate.git",
    "directory": "mcp"
  },
  "keywords": [
    "datacontractgate",
    "aischemagate",
    "data-contracts",
    "odcs",
    "llm-validation",
    "structured-outputs",
    "guardrails",
    "mcp",
    "json-schema"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
