{
  "name": "@nightmoose/contractgate-mcp-server",
  "version": "0.4.0",
  "mcpName": "io.github.nightmoose/contractgate",
  "description": "Official MCP server for DataContractGate (ingest data contracts, ODCS v3.1/v3.2 validation, quarantine and replay) and AISchemaGate (runtime LLM structured-output validation via egress_validate and violation-fed auto-repair).",
  "homepage": "https://github.com/nightmoose/contractgate/tree/staging/mcp#readme",
  "license": "MIT",
  "type": "module",
  "bin": {
    "contractgate-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "prepublishOnly": "npm run build",
    "start": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightmoose/contractgate.git",
    "directory": "mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "datacontractgate",
    "aischemagate",
    "contractgate",
    "data-contracts",
    "odcs",
    "quarantine",
    "replay",
    "egress_validate",
    "structured-output",
    "llm",
    "validation"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
