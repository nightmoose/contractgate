{
  "manifest_version": "0.3",
  "name": "contractgate",
  "display_name": "DataContractGate",
  "version": "0.1.2",
  "description": "Infer, dry-run, deploy, and inspect DataContractGate semantic data contracts.",
  "long_description": "Reject schema-valid but wrong events before they hit your topic. Infer a contract from real events, dry-run it, deploy it, and inspect quarantined events.",
  "author": {
    "name": "DataContractGate",
    "url": "https://github.com/nightmoose"
  },
  "homepage": "https://app.datacontractgate.com/llm-integration.md",
  "documentation": "https://app.datacontractgate.com/mcp-reference.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/nightmoose/contractgate"
  },
  "license": "MIT",
  "keywords": ["data-contracts", "kafka", "schema", "validation", "quarantine"],
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/dist/index.js"],
      "env": {
        "CONTRACTGATE_API_KEY": "${user_config.api_key}",
        "CONTRACTGATE_BASE_URL": "${user_config.base_url}"
      }
    }
  },
  "tools": [
    { "name": "infer_contract", "description": "Infer a contract from sample events" },
    { "name": "validate_events", "description": "Validate events against a contract" },
    { "name": "deploy_contract", "description": "Deploy a contract to stable" },
    { "name": "get_quarantine", "description": "List quarantined events" },
    { "name": "list_contracts", "description": "List contracts" }
  ],
  "user_config": {
    "api_key": {
      "type": "string",
      "title": "DataContractGate API key",
      "description": "cg_live_... key from https://app.datacontractgate.com/account",
      "sensitive": true,
      "required": true
    },
    "base_url": {
      "type": "string",
      "title": "Gateway base URL",
      "description": "Leave as default unless you self-host.",
      "default": "https://app.datacontractgate.com",
      "required": false
    }
  },
  "compatibility": {
    "platforms": ["darwin", "win32", "linux"],
    "runtimes": { "node": ">=20.0.0" }
  }
}
